# Copy to .env to override these development defaults.
SECRET_KEY=replace-with-a-development-secret
DEBUG=False
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
API_BASE_URL=http://localhost:8000
DJANGO_PORT=8000
CSRF_TRUSTED_ORIGINS=http://localhost

# Leave MEDIA_STORAGE_BACKEND unset to use local files in project/media/.
# Set it to storages.backends.s3boto3.S3Boto3Storage to use an S3-compatible service.
# MEDIA_STORAGE_BACKEND=storages.backends.s3boto3.S3Boto3Storage
# AWS_STORAGE_BUCKET_NAME=blog-media
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://objects.example.test
# AWS_S3_ADDRESSING_STYLE=path
# AWS_ACCESS_KEY_ID=replace-with-a-secret
# AWS_SECRET_ACCESS_KEY=replace-with-a-secret
